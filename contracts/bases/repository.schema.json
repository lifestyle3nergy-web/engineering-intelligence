{
  "$id": "lifestyle3nergy:base:repository@1.1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Repository inventory record",
  "type": "object",
  "required": ["repo_id", "full_name", "visibility", "publication"],
  "properties": {
    "repo_id": { "type": "integer", "minimum": 1 },
    "full_name": { "type": "string", "minLength": 3 },
    "visibility": { "enum": ["PUBLIC", "PRIVATE"] },
    "publication": { "enum": ["PUBLIC", "INTERNAL_ONLY"] },
    "fork": { "type": "boolean" },
    "archived": { "type": "boolean" },
    "default_branch": { "type": ["string", "null"] },
    "observed_sha": { "type": ["string", "null"], "pattern": "^[a-f0-9]{40}$" },
    "head_sha": { "type": ["string", "null"], "pattern": "^[a-f0-9]{40}$" },
    "node_id": { "type": ["string", "null"] }
  },
  "allOf": [
    { "if": { "properties": { "publication": { "const": "PUBLIC" } }, "required": ["publication"] }, "then": { "properties": { "visibility": { "const": "PUBLIC" } } } },
    { "if": { "properties": { "publication": { "const": "INTERNAL_ONLY" } }, "required": ["publication"] }, "then": { "properties": { "visibility": { "const": "PRIVATE" } } } }
  ],
  "additionalProperties": true
}
